# คัดลอกไฟล์นี้เป็นชื่อ ".env" (ไฟล์เดียวกันโฟลเดอร์เดียวกับ docker-compose.yml)
# แล้วแก้ค่าตามจริงก่อนรัน docker compose up --build บน Synology

# รหัสผ่านของ Postgres ในเครื่อง (ควรเปลี่ยนจากค่า default)
POSTGRES_PASSWORD=changeme123

# พอร์ตบนตัว NAS ที่จะ map ออกมาให้เข้าถึงจากเครื่องอื่นในบ้าน/บริษัท
# เปลี่ยนได้ถ้าพอร์ตเหล่านี้ชนกับบริการอื่นที่ NAS มีอยู่แล้ว
DB_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=8080

# URL ที่ browser จะใช้ยิงไปหา backend API
# ถ้าเข้าเว็บผ่าน IP ของ NAS ในวง LAN ให้ใส่ IP จริง เช่น:
#   VITE_API_URL=http://192.168.1.50:4000/api
# ถ้าตั้ง reverse proxy + โดเมนของตัวเองผ่าน Synology DDNS ให้ใส่โดเมนแทน เช่น:
#   VITE_API_URL=https://asset-api.mynas.synology.me/api
VITE_API_URL=http://192.168.1.50:4000/api

# ต้องตรงกับ origin ที่ browser เปิดหน้าเว็บจริง (ห้ามมี / ต่อท้าย)
# ถ้ายังไม่แน่ใจ ตั้ง * ไปก่อนเพื่อทดสอบ แล้วค่อยล็อกให้ตรงทีหลัง
CORS_ORIGIN=http://192.168.1.50:8080
